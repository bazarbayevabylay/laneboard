{
  "name": "laneboard",
  "version": "0.3.1",
  "description": "Task board & CLI for AI coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "laneboard": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "docs/agent-guide.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazarbayevabylay/laneboard.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "gen:schema": "node scripts/gen-schema.ts",
    "check:schema": "node scripts/gen-schema.ts --check",
    "gen:skill": "node scripts/gen-skill.ts",
    "check:skill": "node scripts/gen-skill.ts --check",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/core/agent-rules.md dist/core/agent-rules.md",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsonc-parser": "3.3.1",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
