{
  "name": "laneboard",
  "version": "0.4.2",
  "description": "Task board & CLI for AI coding agents",
  "keywords": [
    "tasks",
    "kanban",
    "task-board",
    "agents",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/bazarbayevabylay/laneboard#readme",
  "bugs": {
    "url": "https://github.com/bazarbayevabylay/laneboard/issues"
  },
  "author": "laneboard maintainers",
  "license": "MIT",
  "type": "module",
  "bin": {
    "laneboard": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "docs/agent-guide.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazarbayevabylay/laneboard.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/board/ui/tsconfig.json",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "gen:schema": "node scripts/gen-schema.ts",
    "check:schema": "node scripts/gen-schema.ts --check",
    "gen:skill": "node scripts/gen-skill.ts",
    "check:skill": "node scripts/gen-skill.ts --check",
    "test": "vitest run",
    "build": "rm -rf dist && vite build --config src/board/ui/vite.config.ts --logLevel warn && tsc -p tsconfig.build.json && cp src/core/agent-rules.md dist/core/agent-rules.md",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsonc-parser": "3.3.1",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
