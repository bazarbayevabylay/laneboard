{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^laneboard\\/config@[1-9][0-9]*$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "statuses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "string[]",
              "json"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "events_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attachment_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "list_limit_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "events_per_task",
        "attachment_bytes",
        "list_limit_max"
      ],
      "additionalProperties": false
    },
    "attachments": {
      "type": "object",
      "properties": {
        "deny_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "deny_names"
      ],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "prefix",
    "statuses",
    "fields",
    "limits",
    "attachments",
    "board"
  ],
  "additionalProperties": false,
  "title": "laneboard config (.laneboard/config.json)"
}
